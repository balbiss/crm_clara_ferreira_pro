# Mesma imagem do Dockerfile principal, só muda o CMD final pra rodar o
# supervisor do Solid Queue em vez do servidor web.
#
# Existe porque o Coolify (pelo menos nessa versão) ignora o campo
# "start_command" configurado na UI/API pra apps do tipo "Dockerfile buildpack"
# vindos de repo git — o container sempre roda o CMD que já está gravado na
# imagem, não importa o que for configurado por fora. Confirmado testando:
# o worker ficava de pé rodando Puma/Rails server (o CMD padrão do Dockerfile
# principal) mesmo com start_command="bin/jobs" configurado — nenhum job
# rodava nunca. Ter um Dockerfile próprio com o CMD certo já embutido
# contorna esse bug de vez.

# syntax=docker/dockerfile:1
ARG RUBY_VERSION=3.2.2
FROM docker.io/library/ruby:$RUBY_VERSION-slim AS base

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y curl libjemalloc2 libvips postgresql-client && \
    ln -s /usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2 /usr/local/lib/libjemalloc.so && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV RAILS_ENV="production" \
    BUNDLE_DEPLOYMENT="1" \
    BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_WITHOUT="development" \
    LD_PRELOAD="/usr/local/lib/libjemalloc.so"

FROM base AS build

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libpq-dev libvips libyaml-dev pkg-config && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

COPY vendor/* ./vendor/
COPY Gemfile Gemfile.lock ./

RUN bundle install && \
    rm -rf ~/.bundle/ "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git && \
    bundle exec bootsnap precompile -j 1 --gemfile

COPY . .

# Git no Windows não guarda o bit de execução — restaura explicitamente.
RUN chmod +x bin/*

RUN bundle exec bootsnap precompile -j 1 app/ lib/

FROM base

RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash
USER 1000:1000

COPY --chown=rails:rails --from=build "${BUNDLE_PATH}" "${BUNDLE_PATH}"
COPY --chown=rails:rails --from=build /rails /rails

ENTRYPOINT ["/rails/bin/docker-entrypoint"]

CMD ["bin/jobs"]
